BUILD_ENV='development'
COMPOSE_PROJECT_NAME='cimo_local'
DOCKERFILE='Dockerfile_local'

ENV_NAME='local'
DOMAIN='localhost'
TIME_ZONE='Asia/Tokyo'
LANG='C.UTF-8'
SERVER_PORT='1048'
PATH_ROOT='/home/app/'

MS_SS_NAME='Ms security scan'
MS_SS_LABEL='ms_ss'
MS_SS_IS_DEBUG='true'
MS_SS_NODE_ENV='development'
MS_SS_URL_ROOT=''
MS_SS_URL_CORS_ORIGIN='["http://localhost","https://localhost","http://host.docker.internal","https://host.docker.internal"]'
MS_SS_PATH_CERTIFICATE_KEY='/usr/local/share/ca-certificates/tls.key'
MS_SS_PATH_CERTIFICATE_CRT='/usr/local/share/ca-certificates/tls.crt'
MS_SS_PATH_CERTIFICATE_PEM='/usr/local/share/ca-certificates/ca.pem'
MS_SS_PATH_FILE='file/'
MS_SS_PATH_LOG='log/'
MS_SS_PATH_PUBLIC='public/'
MS_SS_PATH_SCRIPT='script/'
